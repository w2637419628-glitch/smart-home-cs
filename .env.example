# ===== 大模型 =====
# mock     = 离线规则桩，不联网也能完整演示
# openai   = 任意 OpenAI 兼容接口（DeepSeek / 火山豆包 / 通义…）
LLM_PROVIDER=mock

# 接真实模型时，把上面改成 openai，并填下面三项
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 自进化 =====
# 审核通过后是否自动重新归纳总纲（true = 教完立刻生效，演示效果最好）
AUTO_REFRESH_SUMMARY=true

# ===== 检索 =====
PLAYBOOK_TOP_K=4
# 本地 IDF 后端建议 0.25；换 ARK 真向量后可调到 0.5
PLAYBOOK_HIT_THRESHOLD=0.25

# ===== 公网体验模式（挂到公网给别人点开时打开）=====
# true  = 每个 IP 每天限额 + 全站每天限额，防止 API 余额被刷光
# false = 本地开发 / 自己用，不限制
DEMO_MODE=false
DEMO_PER_IP_DAILY=30
DEMO_GLOBAL_DAILY=800
